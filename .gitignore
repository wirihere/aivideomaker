# Generated MP4 renders — large, regenerable via `npx hyperframes render`
renders/

# Large fetched media binaries — regenerable via scripts/fetch-pixabay-music.mjs
# and fetch-pixabay-video.mjs. Don't bloat the repo.
assets/music/
assets/videos/

# Edge TTS voice previews — regenerable via `npm run voices:preview`
assets/voice-library/

# Content-addressed asset cache (sha256-keyed copies of fetched URLs).
# Regenerable on demand. Subdirs like assets/.cache/luts/ are still tracked
# because they're hand-curated — only loose hash-named files are ignored.
assets/.cache/*.*
!assets/.cache/luts/

# HyperFrames runtime / cache
.hyperframes/

# Pixabay/etc fetcher rate-limit tracking
.usage.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
*.backup-*
.video-orchestrator.index.bak
.queue-backup-*.html

# Playwright MCP debug artifacts (screenshots, traces, accessibility snapshots)
.playwright-mcp/

# Smoke baselines + screenshots — regenerable via `npm run smoke:baseline`
smoke/

# backup.mjs snapshots — local "snapshot before risky change" stash.
# Per-machine state, not portable. Operators use git for actual commits.
.backups/

# Test artifacts from new-comp / pull-assets verification runs
compositions/*.backup-*

# Claude Code per-user / runtime state — not portable across machines
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Derived Claude-Design upload artifacts — regenerable from source playbooks
claude-design-upload/
claude-design-context.md
