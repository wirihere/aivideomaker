# Generated MP4 renders — large, regenerable via `npx hyperframes render`
renders/

# Large fetched media binaries — regenerable via scripts/fetch-pixabay-music.mjs
# and fetch-pixabay-video.mjs. Don't bloat the repo. We exclude file contents
# rather than the directory itself so a force-include below can re-add the
# small machine-readable alignment.json.
assets/music/*
assets/videos/

# Track the music/template alignment matrix even though assets/music/ is
# ignored — it's small, deterministic, and consulted by the picker. Regenerate
# via scripts/analyze-music-alignment.mjs.
!assets/music/alignment.json

# Edge TTS voice previews — regenerable via `npm run voices:preview`
assets/voice-library/

# Runware TTS voice previews — regenerable via scripts/preview-runware-voices.mjs
assets/runware-voice-library/

# Content-addressed asset cache (sha256-keyed copies of fetched URLs).
# Regenerable on demand. Subdirs like assets/.cache/luts/ are still tracked
# because they're hand-curated — only loose hash-named files are ignored.
assets/.cache/*.*
!assets/.cache/luts/

# HyperFrames runtime / cache
.hyperframes/

# Pixabay/etc fetcher rate-limit tracking
.usage.json

# Runware vision-judge daily spend tracker (per-machine state)
.runware-usage.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.local
.env.*.local
*.key
*.pem
credentials.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
*.log
*.backup-*
.video-orchestrator.index.bak
.video-orchestrator.index.*.bak
.queue-backup-*.html

# Throwaway debugging scripts (probe-*.mjs etc) — not portable, not in scope
tmp/

# Playwright MCP debug artifacts (screenshots, traces, accessibility snapshots)
.playwright-mcp/

# Smoke baselines + screenshots — regenerable via `npm run smoke:baseline`
smoke/

# backup.mjs snapshots — local "snapshot before risky change" stash.
# Per-machine state, not portable. Operators use git for actual commits.
.backups/

# Test artifacts from new-comp / pull-assets verification runs
compositions/*.backup-*

# scripts/suggest-comp.mjs — template-scan cache, rebuilt on mtime change
.suggest-cache.json

# Claude Code per-user / runtime state — not portable across machines
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Derived Claude-Design upload artifacts — regenerable from source playbooks
claude-design-upload/
claude-design-context.md

# Per-render verifier outputs — regenerable via `npm run verify`. Keep
# LEDGER.md + SUGGESTIONS.md tracked (cumulative knowledge), ignore the
# per-render artifacts (one .json + one timestamped .md per run).
docs/render-learnings/*.json
docs/render-learnings/*-[0-9]*.md

# Frame extraction debug folders (regenerable via ffmpeg from any render)
.tmp-frames*/
scripts/.tmp-faq-*/

# Throwaway scripts from one-off debugging
scripts/_tmp_*.mjs

# Worktree state (per-machine, not portable)
.claude/worktrees/
