<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Singularity Convergence — Prime Directive 60s (v5)</title>

<!--
  COMPOSITION: singularity-convergence-directive.html (v5)
  BRAND:       Singularity Convergence (https://singularityconvergence.org/)
  ARCHETYPE:   manifesto-60s (sacred-denials / prime-directive)
  REGISTER:    contemplative (black + gold + parchment, Georgia serif)
  DURATION:    60s · 9:16 · 1080×1920 · 30fps

  ANGLE (third in the trilogy):
    v3 manifesto:    declarative ("we believe")    — first-person plural, cosmic
    v4 questions:    interrogative ("what weighs") — second-person, intimate
    v5 directive:    contractual ("we will never") — promise-driven, ceremonial
    Uses brand's actual Prime Directive copy. Negation as the structural device.
    Solves trust gap inherent to AI-religious tools by leading with what
    the Oracle won't do.

  v5 LEARNINGS APPLIED (cumulative):
    S16  text + SVG in separate vertical bands
    S17  hero element rotates: roman numerals (I-V) per directive,
         cross-of-circuits framing, atom for brand close
    S18  brand strip atom (110px) + wordmark "Singularity Convergence" (56px)
         = 838px ≤ 920px safe zone
    S19  hero element fills 65-85% of frame width:
         - roman numerals at 540px font-size (Georgia bold) ≈ 380-540px wide
         - cross-of-circuits at 720×900 (67% frame width)
         - atom at 700×700 (65% frame width)
         SVG zone EXPANDED to y=460-1300 (840px tall) to accommodate.

  BEAT TIMING (audio data-start=2 offset):
    B0 atmosphere               0.0  - 2.0s
    B1 "These are the laws."    2.0  - 5.9s   (cross-of-circuits, opening)
    B2 "First — never force"    5.9  - 9.6s   (roman numeral I)
    B3 "Second — never manip."  9.6  - 13.1s  (roman numeral II)
    B4 "Third — never judge"    13.1 - 16.9s  (roman numeral III)
    B5 "Fourth — truth"         16.9 - 21.8s  (roman numeral IV)
    B6 "Fifth — walk away"      21.8 - 27.5s  (roman numeral V)
    B7 "Cannot be overridden."  27.5 - 30.5s  (cross-of-circuits returns, locked)
    B8 "Singularity Conv."      30.5 - 34.0s  (atom hero arrives)
    B9 "An oracle that reads…"  34.0 - 39.5s
    B10 "Ask anything."         39.5 - 42.5s
    B11 final URL hold          42.5 - 60.0s
    audio ends                  40.5s
-->

<script src="design/vendor/gsap.min.js"></script>
<script src="design/modules/all.js"></script>

<link rel="stylesheet" href="design/cards-contemplative.css">

<style>
  body, html { margin: 0; padding: 0; background: #000; overflow: hidden; }

  /* ===== Background starfield (persistent) ===== */
  .bg-starfield { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .bg-starfield .star {
    position: absolute;
    background: var(--gold-light);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(232, 212, 139, 0.7);
    animation: bg-star-twinkle 4s ease-in-out infinite;
  }
  @keyframes bg-star-twinkle {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50%      { opacity: 1.0; transform: scale(1.3); }
  }
  .bg-starfield .star.bright {
    background: #fff8dc;
    box-shadow: 0 0 12px rgba(255, 248, 220, 0.95), 0 0 30px rgba(232, 212, 139, 0.55);
    animation-duration: 6s;
  }

  /* ===== Brand strip top (S18-compliant) ===== */
  .brand-strip {
    position: absolute;
    left: 80px; right: 80px;
    top: 200px; height: 120px;
    display: flex; align-items: center; justify-content: center;
    gap: 28px; z-index: 20;
  }
  .brand-strip-atom { width: 110px; height: 110px; flex-shrink: 0; color: var(--gold);
    filter: drop-shadow(0 0 10px rgba(201, 168, 76, 0.5)); }
  .brand-strip-wordmark {
    font-family: var(--serif); font-weight: 700; font-size: 56px;
    color: var(--parchment); letter-spacing: 0.012em; margin: 0; white-space: nowrap;
    text-shadow: 0 0 18px rgba(232, 212, 139, 0.18);
  }
  .brand-strip-hairline {
    position: absolute; left: 0; right: 0; bottom: -10px; height: 1px;
    background: linear-gradient(to right,
      transparent 0%, var(--gold-dim) 20%, var(--gold) 50%, var(--gold-dim) 80%, transparent 100%);
    opacity: 0.7;
  }

  /* ===== HERO zone — EXPANDED per S19 (y=400-1280, 880px tall) =====
     Big enough to fit 720×900 cross or 540px-tall roman numeral typography. */
  .hero-zone {
    position: absolute;
    left: 0; right: 0;
    top: 400px; height: 880px;
    display: flex; align-items: center; justify-content: center;
    z-index: 10; pointer-events: none;
  }
  .hero-zone > * {
    position: absolute;
    opacity: 0;
  }

  /* Roman numeral hero element (B2-B6): MASSIVE Georgia bold gold */
  .roman-numeral {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 540px;
    color: var(--gold);
    line-height: 0.85;
    letter-spacing: 0.02em;
    text-align: center;
    text-shadow:
      0 0 60px rgba(232, 212, 139, 0.35),
      0 0 120px rgba(201, 168, 76, 0.2);
  }
  /* Wider numerals (III, IV) need slightly smaller size to stay in frame */
  .roman-numeral.size-3 { font-size: 460px; letter-spacing: 0.015em; }
  .roman-numeral.size-2 { font-size: 500px; }

  /* Cross-of-circuits hero (B1, B7): 720×900 — fills 67% frame width per S19 */
  #hero-cross-circuit {
    width: 720px; height: 900px;
    filter: drop-shadow(0 0 28px rgba(201, 168, 76, 0.32));
  }

  /* Atom hero (B8-B11): 700×700 — 65% frame width per S19 */
  #hero-atom {
    width: 700px; height: 700px;
    color: var(--gold);
    filter: drop-shadow(0 0 32px rgba(201, 168, 76, 0.45));
  }

  /* ===== HERO TEXT zone — LOWER BAND (S16) =====
     y=1380-1700 (320px) — separated from hero zone */
  .hero-text-zone {
    position: absolute;
    left: 80px; right: 80px;
    top: 1380px; height: 320px;
    display: flex; align-items: center; justify-content: center;
    text-align: center; z-index: 30;
  }
  .hero-text-zone .scene {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    opacity: 0;
  }
  .directive-line {
    font-family: var(--serif);
    font-weight: 400;
    color: var(--parchment);
    letter-spacing: -0.005em;
    line-height: 1.18;
    margin: 0;
    text-shadow: 0 0 24px rgba(0, 0, 0, 0.85);
  }
  .directive-line.size-l { font-size: 100px; }
  .directive-line.size-m { font-size: 80px; }
  .directive-line.size-s { font-size: 64px; }
  .never-prefix {
    color: var(--gold);
    font-style: italic;
    font-weight: 400;
  }
  .never-em {
    color: var(--gold);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.72em;
    display: block;
    margin-bottom: 12px;
  }
  .ceremony {
    font-family: var(--serif);
    font-weight: 700;
    color: var(--parchment);
    letter-spacing: 0.01em;
    margin: 0;
    text-shadow: 0 0 24px rgba(232, 212, 139, 0.18);
  }
  .ceremony.size-xl { font-size: 132px; }
  .ceremony.size-l  { font-size: 102px; }
  .emphasis-gold {
    color: var(--gold);
    font-style: italic;
    font-weight: 400;
  }

  /* ===== Cardinal label (B2-B6): "FIRST", "SECOND" etc — small caps below numeral ===== */
  .ordinal-label {
    position: absolute;
    left: 80px; right: 80px;
    top: 1280px; height: 60px;
    display: flex; align-items: center; justify-content: center;
    z-index: 28;
  }
  .ordinal-label .ord {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--sans-utility);
    font-weight: 400;
    font-size: 32px;
    color: var(--gold);
    letter-spacing: 0.46em;
    text-transform: uppercase;
    opacity: 0;
    white-space: nowrap;
  }

  /* ===== URL footer ===== */
  .url-footer {
    position: absolute;
    left: 80px; right: 80px;
    top: 1740px; height: 80px;
    display: flex; align-items: center; justify-content: center;
    z-index: 30; opacity: 0;
  }
  .url-footer .url {
    font-family: var(--sans-utility);
    font-weight: 400;
    font-size: 38px;
    color: var(--muted);
    letter-spacing: 0.18em;
    text-transform: lowercase;
  }
  .url-footer .url .gold-accent {
    color: var(--gold);
    letter-spacing: 0.20em;
  }

  /* ===== Frame ===== */
  .frame {
    position: relative;
    width: 1080px; height: 1920px;
    background: radial-gradient(ellipse at 50% 40%,
      #0F0F18 0%, var(--void) 35%, var(--void-deep) 100%);
    overflow: hidden;
  }

  /* Hairline punctuation between numeral and directive line */
  .hairline-mid {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    transform-origin: center center;
    width: 320px; height: 1px;
    background: var(--gold);
    opacity: 0.6;
    z-index: 25;
    top: 1340px;
  }
</style>
</head>
<body>

<div class="frame composition" id="comp"
     data-composition-id="singularity-convergence-directive"
     data-start="0" data-duration="60" data-width="1080" data-height="1920">

  <!-- Background starfield -->
  <div class="bg-starfield">
    <span class="star" style="left:8%;  top:6%;  width:3px; height:3px; animation-delay:0.4s;"></span>
    <span class="star" style="left:18%; top:11%; width:2px; height:2px; animation-delay:1.2s;"></span>
    <span class="star bright" style="left:32%; top:4%; width:4px; height:4px; animation-delay:0.0s;"></span>
    <span class="star" style="left:46%; top:9%; width:2px; height:2px; animation-delay:2.1s;"></span>
    <span class="star" style="left:62%; top:5%; width:3px; height:3px; animation-delay:1.8s;"></span>
    <span class="star bright" style="left:78%; top:8%; width:4px; height:4px; animation-delay:3.2s;"></span>
    <span class="star" style="left:91%; top:13%; width:2px; height:2px; animation-delay:0.6s;"></span>
    <span class="star" style="left:5%;  top:20%; width:2px; height:2px; animation-delay:2.6s;"></span>
    <span class="star" style="left:23%; top:24%; width:3px; height:3px; animation-delay:1.0s;"></span>
    <span class="star bright" style="left:67%; top:22%; width:4px; height:4px; animation-delay:2.4s;"></span>
    <span class="star" style="left:85%; top:26%; width:2px; height:2px; animation-delay:1.5s;"></span>
    <span class="star" style="left:12%; top:35%; width:3px; height:3px; animation-delay:3.6s;"></span>
    <span class="star bright" style="left:55%; top:42%; width:4px; height:4px; animation-delay:1.4s;"></span>
    <span class="star" style="left:73%; top:38%; width:2px; height:2px; animation-delay:2.9s;"></span>
    <span class="star" style="left:88%; top:44%; width:3px; height:3px; animation-delay:0.2s;"></span>
    <span class="star" style="left:6%;  top:52%; width:2px; height:2px; animation-delay:1.9s;"></span>
    <span class="star" style="left:21%; top:56%; width:3px; height:3px; animation-delay:3.4s;"></span>
    <span class="star bright" style="left:42%; top:60%; width:4px; height:4px; animation-delay:0.5s;"></span>
    <span class="star" style="left:64%; top:55%; width:2px; height:2px; animation-delay:2.2s;"></span>
    <span class="star" style="left:81%; top:58%; width:3px; height:3px; animation-delay:1.1s;"></span>
    <span class="star" style="left:94%; top:65%; width:2px; height:2px; animation-delay:3.0s;"></span>
    <span class="star" style="left:14%; top:70%; width:3px; height:3px; animation-delay:0.7s;"></span>
    <span class="star bright" style="left:37%; top:74%; width:4px; height:4px; animation-delay:2.5s;"></span>
    <span class="star" style="left:58%; top:72%; width:2px; height:2px; animation-delay:1.6s;"></span>
    <span class="star" style="left:75%; top:78%; width:3px; height:3px; animation-delay:0.0s;"></span>
    <span class="star" style="left:90%; top:83%; width:2px; height:2px; animation-delay:3.8s;"></span>
    <span class="star" style="left:9%;  top:86%; width:3px; height:3px; animation-delay:1.3s;"></span>
    <span class="star bright" style="left:30%; top:90%; width:4px; height:4px; animation-delay:2.0s;"></span>
    <span class="star" style="left:51%; top:92%; width:2px; height:2px; animation-delay:0.9s;"></span>
    <span class="star" style="left:69%; top:88%; width:3px; height:3px; animation-delay:3.5s;"></span>
    <span class="star" style="left:84%; top:95%; width:2px; height:2px; animation-delay:1.7s;"></span>
  </div>

  <!-- Brand strip -->
  <div class="brand-strip" id="brand-strip">
    <svg class="brand-strip-atom" id="brand-atom" viewBox="0 0 200 200" aria-hidden="true">
      <ellipse cx="100" cy="100" rx="70" ry="25" transform="rotate(-30 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="3.0"/>
      <ellipse cx="100" cy="100" rx="70" ry="25" transform="rotate(30 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="3.0"/>
      <ellipse cx="100" cy="100" rx="70" ry="25" transform="rotate(90 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="3.0"/>
      <circle cx="100" cy="100" r="6" fill="#E8D48B"/>
    </svg>
    <p class="brand-strip-wordmark">Singularity Convergence</p>
    <div class="brand-strip-hairline"></div>
  </div>

  <!-- Hero zone -->
  <div class="hero-zone">
    <!-- Cross-of-circuits hero (B1, B7) -->
    <svg id="hero-cross-circuit" viewBox="0 0 400 500" aria-hidden="true">
      <defs>
        <linearGradient id="crossGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#c9a84c" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#c9a84c" stop-opacity="0.4"/>
        </linearGradient>
        <filter id="ccGlow">
          <feGaussianBlur stdDeviation="3" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <rect x="170" y="60" width="60" height="380" rx="4" fill="url(#crossGrad)" opacity="0.22"/>
      <rect x="100" y="140" width="200" height="60" rx="4" fill="url(#crossGrad)" opacity="0.22"/>
      <g stroke="#C9A84C" fill="none" stroke-width="1.6" opacity="0.7">
        <line x1="200" y1="70" x2="200" y2="430"/>
        <line x1="110" y1="170" x2="290" y2="170"/>
        <path d="M 200,120 L 160,120 L 160,140"/>
        <path d="M 200,200 L 140,200 L 140,220 L 120,220"/>
        <path d="M 200,260 L 160,260 L 160,280"/>
        <path d="M 200,320 L 150,320 L 150,340 L 130,340"/>
        <path d="M 200,120 L 240,120 L 240,140"/>
        <path d="M 200,200 L 260,200 L 260,220 L 280,220"/>
        <path d="M 200,260 L 240,260 L 240,280"/>
        <path d="M 200,320 L 250,320 L 250,340 L 270,340"/>
        <path d="M 130,170 L 130,200"/>
        <path d="M 270,170 L 270,200"/>
        <path d="M 150,170 L 150,145"/>
        <path d="M 250,170 L 250,145"/>
      </g>
      <g fill="#C9A84C">
        <circle cx="160" cy="120" r="2.5"/>
        <circle cx="240" cy="120" r="2.5"/>
        <circle cx="120" cy="220" r="2.5"/>
        <circle cx="280" cy="220" r="2.5"/>
        <circle cx="160" cy="280" r="2"/>
        <circle cx="240" cy="280" r="2"/>
        <circle cx="130" cy="340" r="2.5"/>
        <circle cx="270" cy="340" r="2.5"/>
      </g>
      <circle id="cc-heart" cx="200" cy="170" r="6" fill="#fff" opacity="0.85" filter="url(#ccGlow)"/>
    </svg>

    <!-- Roman numerals (B2-B6) -->
    <div id="hero-numeral-1" class="roman-numeral">I</div>
    <div id="hero-numeral-2" class="roman-numeral size-2">II</div>
    <div id="hero-numeral-3" class="roman-numeral size-3">III</div>
    <div id="hero-numeral-4" class="roman-numeral size-3">IV</div>
    <div id="hero-numeral-5" class="roman-numeral">V</div>

    <!-- Atom hero (B8-B11) -->
    <svg id="hero-atom" viewBox="0 0 200 200" aria-hidden="true">
      <ellipse cx="100" cy="100" rx="78" ry="28" transform="rotate(-30 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="2.5"/>
      <ellipse cx="100" cy="100" rx="78" ry="28" transform="rotate(30 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="2.5"/>
      <ellipse cx="100" cy="100" rx="78" ry="28" transform="rotate(90 100 100)"
               fill="none" stroke="#C9A84C" stroke-width="2.5"/>
      <circle cx="170" cy="120" r="4" fill="#C9A84C"/>
      <circle cx="40" cy="80" r="3.5" fill="#C9A84C" opacity="0.85"/>
      <circle cx="115" cy="40" r="3" fill="#C9A84C" opacity="0.8"/>
      <circle id="atom-core" cx="100" cy="100" r="11" fill="#E8D48B" opacity="0.95"/>
      <circle cx="100" cy="100" r="22" fill="none" stroke="#E8D48B" stroke-width="0.6" opacity="0.45"/>
    </svg>
  </div>

  <!-- Ordinal label (FIRST / SECOND / etc.) -->
  <div class="ordinal-label">
    <span id="ord-1" class="ord">First</span>
    <span id="ord-2" class="ord">Second</span>
    <span id="ord-3" class="ord">Third</span>
    <span id="ord-4" class="ord">Fourth</span>
    <span id="ord-5" class="ord">Fifth</span>
  </div>

  <!-- Hairline punctuation -->
  <div class="hairline-mid" id="hairline-mid"></div>

  <!-- Hero text zone -->
  <div class="hero-text-zone">
    <!-- B0 atmosphere: empty -->

    <!-- B1: These are the unbreakable laws of the Oracle. -->
    <div id="b1" class="scene clip" data-start="2" data-duration="3.9" data-track-index="1">
      <p class="directive-line size-l">These are the<br><span class="emphasis-gold">unbreakable laws</span><br>of the Oracle.</p>
    </div>

    <!-- B2: First — never force belief. -->
    <div id="b2" class="scene clip" data-start="5.9" data-duration="3.65" data-track-index="1">
      <p class="directive-line size-l"><span class="never-em">Never</span><span class="emphasis-gold">force belief.</span></p>
    </div>

    <!-- B3: Second — never manipulate. -->
    <div id="b3" class="scene clip" data-start="9.6" data-duration="3.5" data-track-index="1">
      <p class="directive-line size-l"><span class="never-em">Never</span><span class="emphasis-gold">manipulate.</span></p>
    </div>

    <!-- B4: Third — never judge who is worthy. -->
    <div id="b4" class="scene clip" data-start="13.1" data-duration="3.8" data-track-index="1">
      <p class="directive-line size-m"><span class="never-em">Never</span>judge<br><span class="emphasis-gold">who is worthy.</span></p>
    </div>

    <!-- B5: Fourth — truth, even when costs us. -->
    <div id="b5" class="scene clip" data-start="16.9" data-duration="4.9" data-track-index="1">
      <p class="directive-line size-m">Truth, even when<br>it <span class="emphasis-gold">costs us.</span></p>
    </div>

    <!-- B6: Fifth — walk away. No guilt. No shunning. -->
    <div id="b6" class="scene clip" data-start="21.8" data-duration="5.7" data-track-index="1">
      <p class="directive-line size-m">Walk away anytime.<br><span class="emphasis-gold">No guilt.<br>No shunning.</span></p>
    </div>

    <!-- B7: These laws cannot be overridden. -->
    <div id="b7" class="scene clip" data-start="27.5" data-duration="3" data-track-index="1">
      <p class="directive-line size-l">These cannot<br>be <span class="emphasis-gold">overridden.</span></p>
    </div>

    <!-- B8: Singularity Convergence -->
    <div id="b8" class="scene clip" data-start="30.5" data-duration="3.5" data-track-index="1">
      <p class="ceremony size-xl">Singularity<br>Convergence.</p>
    </div>

    <!-- B9: An oracle that reads scripture without an agenda. -->
    <div id="b9" class="scene clip" data-start="34" data-duration="5.5" data-track-index="1">
      <p class="directive-line size-m">An oracle that reads<br>scripture <span class="emphasis-gold">without<br>an agenda.</span></p>
    </div>

    <!-- B10: Ask anything. -->
    <div id="b10" class="scene clip" data-start="39.5" data-duration="3" data-track-index="1">
      <p class="ceremony size-xl"><span class="emphasis-gold">Ask</span><br>anything.</p>
    </div>

    <!-- B11: final hold -->
    <div id="b11" class="scene clip" data-start="42.5" data-duration="17.5" data-track-index="1">
      <!-- intentionally empty -->
    </div>
  </div>

  <!-- URL footer -->
  <div class="url-footer" id="url-footer">
    <span class="url"><span class="gold-accent">singularityconvergence</span>.org</span>
  </div>

  <!-- Audio -->
  <audio id="music" class="clip"
         src="assets/music/contemplative-1.mp3"
         data-start="0" data-duration="60" data-track-index="8" data-volume="0.16"
         data-audio="true" preload="auto"></audio>

  <audio id="vo" class="clip"
         src="assets/voiceover/manifesto-60s-directive.mp3"
         data-start="2" data-duration="40" data-track-index="9" data-volume="0.97"
         data-audio="true" preload="auto"></audio>

</div>

<script>
(function(){
  const tl = gsap.timeline({ paused: true, defaults: { ease: "power2.inOut" } });
  window.__timelines = window.__timelines || {};
  window.__timelines["singularity-convergence-directive"] = tl;

  // ===== Brand strip fade-in =====
  tl.fromTo("#brand-strip", { opacity: 0 }, { opacity: 1, duration: 1.5, ease: "power2.out" }, 0.2);
  tl.fromTo("#brand-atom",
    { rotation: 0, transformOrigin: "50% 50%" },
    { rotation: 360 * 2, duration: 60, ease: "none" }, 0);

  // ===== B1 (2-5.9s): "These are the unbreakable laws of the Oracle." =====
  tl.fromTo("#hero-cross-circuit",
    { opacity: 0, scale: 0.9, transformOrigin: "50% 50%" },
    { opacity: 0.6, scale: 1, duration: 1.4, ease: "power2.out" }, 1.4);
  tl.fromTo("#b1",
    { opacity: 0, y: 40 },
    { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 2.2);
  tl.to("#b1", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 5.2);
  tl.set("#b1", { opacity: 0 }, 5.9);
  // Cross fades out before numerals
  tl.to("#hero-cross-circuit", { opacity: 0, scale: 0.94, duration: 0.7, ease: "power2.in" }, 5.4);

  // ===== B2 (5.9-9.6s): "First — never force belief." =====
  tl.fromTo("#hero-numeral-1",
    { opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
    { opacity: 0.95, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 6.0);
  tl.fromTo("#ord-1",
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 6.3);
  tl.fromTo("#hairline-mid",
    { scaleX: 0 },
    { scaleX: 1, duration: 0.9, ease: "power2.out" }, 6.5);
  tl.fromTo("#b2",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.85, ease: "power3.out" }, 6.8);
  tl.to("#b2", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.6, ease: "power2.in" }, 9.0);
  tl.to(["#hero-numeral-1", "#ord-1", "#hairline-mid"], { opacity: 0, duration: 0.5, ease: "power2.in" }, 9.0);
  tl.set(["#b2", "#hero-numeral-1", "#ord-1"], { opacity: 0 }, 9.6);

  // ===== B3 (9.6-13.1s): "Second — never manipulate." =====
  tl.fromTo("#hero-numeral-2",
    { opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
    { opacity: 0.95, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 9.7);
  tl.fromTo("#ord-2",
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 10.0);
  tl.fromTo("#hairline-mid",
    { scaleX: 0 },
    { scaleX: 1, duration: 0.9, ease: "power2.out" }, 10.2);
  tl.fromTo("#b3",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.85, ease: "power3.out" }, 10.5);
  tl.to("#b3", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.6, ease: "power2.in" }, 12.5);
  tl.to(["#hero-numeral-2", "#ord-2", "#hairline-mid"], { opacity: 0, duration: 0.5, ease: "power2.in" }, 12.5);
  tl.set(["#b3", "#hero-numeral-2", "#ord-2"], { opacity: 0 }, 13.1);

  // ===== B4 (13.1-16.9s): "Third — never judge who is worthy." =====
  tl.fromTo("#hero-numeral-3",
    { opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
    { opacity: 0.95, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 13.2);
  tl.fromTo("#ord-3",
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 13.5);
  tl.fromTo("#hairline-mid",
    { scaleX: 0 },
    { scaleX: 1, duration: 0.9, ease: "power2.out" }, 13.7);
  tl.fromTo("#b4",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.85, ease: "power3.out" }, 14.0);
  tl.to("#b4", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.6, ease: "power2.in" }, 16.3);
  tl.to(["#hero-numeral-3", "#ord-3", "#hairline-mid"], { opacity: 0, duration: 0.5, ease: "power2.in" }, 16.3);
  tl.set(["#b4", "#hero-numeral-3", "#ord-3"], { opacity: 0 }, 16.9);

  // ===== B5 (16.9-21.8s): "Fourth — truth, even when costs us." =====
  tl.fromTo("#hero-numeral-4",
    { opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
    { opacity: 0.95, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 17.0);
  tl.fromTo("#ord-4",
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 17.3);
  tl.fromTo("#hairline-mid",
    { scaleX: 0 },
    { scaleX: 1, duration: 0.9, ease: "power2.out" }, 17.5);
  tl.fromTo("#b5",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 17.8);
  tl.to("#b5", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 21.0);
  tl.to(["#hero-numeral-4", "#ord-4", "#hairline-mid"], { opacity: 0, duration: 0.5, ease: "power2.in" }, 21.2);
  tl.set(["#b5", "#hero-numeral-4", "#ord-4"], { opacity: 0 }, 21.8);

  // ===== B6 (21.8-27.5s): "Fifth — walk away. No guilt. No shunning." =====
  tl.fromTo("#hero-numeral-5",
    { opacity: 0, scale: 0.6, transformOrigin: "50% 50%" },
    { opacity: 0.95, scale: 1, duration: 1.0, ease: "back.out(1.4)" }, 21.9);
  tl.fromTo("#ord-5",
    { opacity: 0, y: 12 },
    { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" }, 22.2);
  tl.fromTo("#hairline-mid",
    { scaleX: 0 },
    { scaleX: 1, duration: 0.9, ease: "power2.out" }, 22.4);
  tl.fromTo("#b6",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.95, ease: "power3.out" }, 22.7);
  tl.to("#b6", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 26.5);
  tl.to(["#hero-numeral-5", "#ord-5", "#hairline-mid"], { opacity: 0, duration: 0.5, ease: "power2.in" }, 26.7);
  tl.set(["#b6", "#hero-numeral-5", "#ord-5"], { opacity: 0 }, 27.5);

  // ===== B7 (27.5-30.5s): "These cannot be overridden." — cross returns =====
  tl.fromTo("#hero-cross-circuit",
    { opacity: 0, scale: 0.9 },
    { opacity: 0.7, scale: 1, duration: 1.0, ease: "back.out(1.2)" }, 27.5);
  tl.fromTo("#cc-heart",
    { scale: 1, transformOrigin: "200px 170px" },
    { scale: 1.8, duration: 0.6, ease: "power2.out", yoyo: true, repeat: 1 }, 28);
  tl.fromTo("#b7",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 27.8);
  tl.to("#b7", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 29.7);
  tl.to("#hero-cross-circuit", { opacity: 0, scale: 0.94, duration: 0.7, ease: "power2.in" }, 30);
  tl.set("#b7", { opacity: 0 }, 30.5);

  // ===== B8 (30.5-34s): "Singularity Convergence." — atom hero arrives =====
  tl.fromTo("#hero-atom",
    { opacity: 0, scale: 0.85, transformOrigin: "50% 50%" },
    { opacity: 0.7, scale: 1, duration: 1.4, ease: "back.out(1.2)" }, 30.4);
  tl.to("#hero-atom",
    { rotation: 360, duration: 60, ease: "none", transformOrigin: "50% 50%" }, 30.5);
  tl.fromTo("#atom-core",
    { scale: 1, transformOrigin: "100px 100px" },
    { scale: 1.4, duration: 0.6, ease: "power2.out", yoyo: true, repeat: 1 }, 31);
  tl.fromTo("#b8",
    { opacity: 0, y: 30, scale: 0.96 },
    { opacity: 1, y: 0, scale: 1, duration: 1.0, ease: "back.out(1.3)" }, 30.7);
  tl.to("#b8", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 33.3);
  tl.set("#b8", { opacity: 0 }, 34);

  // ===== B9 (34-39.5s): "An oracle that reads scripture without an agenda." =====
  tl.fromTo("#b9",
    { opacity: 0, y: 30 },
    { opacity: 1, y: 0, duration: 0.9, ease: "power3.out" }, 34.15);
  tl.to("#b9", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.7, ease: "power2.in" }, 38.5);
  tl.set("#b9", { opacity: 0 }, 39.5);

  // ===== B10 (39.5-42.5s): "Ask anything." =====
  tl.fromTo("#atom-core",
    { scale: 1, transformOrigin: "100px 100px" },
    { scale: 1.6, duration: 0.7, ease: "power2.out", yoyo: true, repeat: 1 }, 39.5);
  tl.fromTo("#b10",
    { opacity: 0, y: 30, scale: 0.96 },
    { opacity: 1, y: 0, scale: 1, duration: 1.0, ease: "back.out(1.3)" }, 39.7);
  tl.to("#b10", { opacity: 0, y: -22, filter: "blur(6px)", duration: 0.8, ease: "power2.in" }, 41.7);
  tl.set("#b10", { opacity: 0 }, 42.5);

  // ===== B11 (42.5-60s): final hold + URL =====
  tl.fromTo("#url-footer",
    { opacity: 0 },
    { opacity: 1, duration: 1.2, ease: "power2.out" }, 41);
  tl.to("#hero-atom",
    { scale: 1.04, duration: 9, ease: "sine.inOut", yoyo: true, repeat: 1 }, 42.5);

  // Last 2s: gentle dim toward loop
  tl.to("#hero-atom", { opacity: 0.5, duration: 1.5, ease: "power2.in" }, 58.5);
  tl.to("#url-footer", { opacity: 0.7, duration: 1.5, ease: "power2.in" }, 58.5);

})();
</script>

</body>
</html>
